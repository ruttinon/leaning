{
  "name": "online-learning-platform",
  "version": "1.0.0",
  "description": "Online Learning & Tutor Platform",
  "scripts": {
    "dev": "powershell -ExecutionPolicy Bypass -File ./scripts/dev.ps1",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "cd backend && npm run build",
    "build:frontend": "cd frontend && npm run build",
    "start": "cd backend && npm run start",
    "seed": "cd backend && npm run prisma:seed",
    "db:migrate": "cd backend && npm run prisma:migrate",
    "db:generate": "cd backend && npm run prisma:generate"
  },
  "keywords": ["online-learning", "education", "tutor"],
  "author": "",
  "license": "MIT"
}
